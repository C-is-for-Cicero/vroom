# Copy to deploy/.env and fill in. Never commit .env.
DOMAIN=your-subdomain.duckdns.org
# Session-cookie signing key; generate with: openssl rand -hex 32
VROOM_SECRET_KEY=
# Cookies marked Secure (HTTPS only) - keep 1 in production behind Caddy
VROOM_COOKIE_SECURE=1
# The Odds API key for the bookmaker-implied-probability baseline (optional).
ODDS_API_KEY=
